# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Système / éditeurs ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Portraits : gabarit « archive » non référencé (~140 Ko/personnage) ---
# Seuls sont versionnés : -web.webp, -vignette.webp et la planche contact.
# (script de purge de l'historique : scripts/retirer_archives_git.sh)
/portraits/*.webp
!/portraits/*-web.webp
!/portraits/*-vignette.webp
!/portraits/planche-contact-generale.webp

# --- Feuilles temporaires ---
*.tmp
~$*.xlsx

# --- Classeur maître PRIVÉ : il contient la feuille Narration (factions,
#     répliques, arcs), qui ne doit pas être diffusée. Il est régénéré par
#     construire_base.py à partir de data/narration.csv (source privée, elle
#     aussi ignorée). Seul le classeur PUBLIC est versionné.
/base_personnages_fictifs-complet.xlsx

# --- Narration : source privée, non versionnée (voir README « Narration »).
#     Le vocabulaire des factions, lui, est public : data/factions.txt.
/data/narration.csv
